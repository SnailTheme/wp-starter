{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "stwp/el-wrapper",
  "title": "Elemental Wrapper",
  "category": "st-wp-starter",
  "icon": "layout",
  "textdomain": "st-wp-starter",
  "allowedBlocks": [
    "stwp/el-container",
    "stwp/el-heading",
    "stwp/el-text",
    "stwp/el-columns",
    "stwp/el-grid",
    "stwp/el-content-with-image"
  ],
  "acf": {
    "blockVersion": 3,
    "renderTemplate": "block-render.php"
  },
  "supports": {
    "jsx": true,
    "html": false,
    "align": [
      "full"
    ],
    "color": {
      "background": true,
      "text": false,
      "gradients": false
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "viewStyle": [
    "file:./assets/css/view-style.min.css"
  ],
  "editorStyle": [
    "file:./assets/css/editor-style.min.css"
  ],
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    }
  }
}
