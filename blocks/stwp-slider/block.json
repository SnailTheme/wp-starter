{
  "apiVersion": 3,
  "name": "stwp/slider",
  "title": "Slider Section",
  "description": "ST WP Starter Slider section.",
  "viewStyle": [ "plugins.splidejs.core", "file:./assets/css/view-style.min.css" ],
  "editorStyle": [ "plugins.splidejs.core", "file:./assets/css/editor-style.min.css" ],
  "viewScript": [ "plugins.splidejs.splide", "file:./assets/js/viewScripts.js" ],
  "editorScript": [ "plugins.splidejs.splide", "file:./assets/js/editorScripts.js" ],
  "category": "st-wp-starter",
  "icon": "dashicons dashicons-slides",
  "keywords": [
    "slider, vertical slider, horizontal slider"
  ],
  "acf": {
    "blockVersion": 3,
    "mode": "preview",
    "renderTemplate": "block-render.php"
  },
  "example": {
    "attributes": {
      "preview": true,
      "data": {
        "preview_image_help": "block-image-preview.png"
      }
    }
  },
  "supports": {
    "align": [
      "full"
    ],
    "spacing": {
      "margin": [
        "top",
        "bottom"
      ],
      "padding": [
        "top",
        "bottom"
      ],
      "units": [
        "px"
      ]
    },
    "anchor": true
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    }
  }
}
