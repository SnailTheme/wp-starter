{
  "name": "snailtheme/wp-starter",
  "type": "wordpress-theme",
  "description": "Starter Theme for WordPress",
  "keywords": [
    "WordPress",
    "Themes"
  ],
  "homepage": "https://github.com/snailtheme/wp-starter",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "SnailTheme",
      "homepage": "https://www.snailtheme.com/"
    }
  ],
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "snailtheme/wp-starter-toolkit": "dev-next",
    "squizlabs/php_codesniffer": "^3.9",
    "wp-coding-standards/wpcs": "dev-main",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "wp-cli/wp-cli": "^2.9",
    "wp-cli/i18n-command": "^2.3",
    "symfony/var-dumper": "^7.2"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/snailtheme/wp-starter-toolkit.git"
    }
  ],
  "scripts": {
    "lint:wpcs": "@php vendor/bin/phpcs",
    "lint:wpcs:fix": "@php vendor/bin/phpcbf",
    "lint:php": "@php vendor/bin/parallel-lint --exclude vendor --exclude node_modules .",
    "st-toolkit": "@php vendor/bin/st-toolkit",
    "toolkit:init": "@php vendor/bin/st-toolkit init --theme=.",
    "toolkit:doctor": "@php vendor/bin/st-toolkit doctor --theme=.",
    "toolkit:core-check": "@php vendor/bin/st-toolkit core:check --theme=.",
    "toolkit:core-update": "@php vendor/bin/st-toolkit core:update --theme=.",
    "toolkit:core-update:dry-run": "@php vendor/bin/st-toolkit core:update --theme=. --dry-run",
    "toolkit:core-rollback": "@php vendor/bin/st-toolkit core:rollback --theme=.",
    "toolkit:blocks-list": "@php vendor/bin/st-toolkit blocks:list",
    "toolkit:blocks-install": "@php vendor/bin/st-toolkit blocks:install --theme=.",
    "toolkit:blocks-install:dry-run": "@php vendor/bin/st-toolkit blocks:install --theme=. --dry-run",
    "make-pot": [
      "@php vendor/wp-cli/wp-cli/php/boot-fs.php i18n make-pot . languages/st-wp-starter.pot --slug=st-wp-starter --domain=st-wp-starter",
      "@php core/tools/normalize-pot.php languages/st-wp-starter.pot"
    ]
  },
  "support": {
    "issues": "https://github.com/snailtheme/wp-starter/issues",
    "source": "https://github.com/snailtheme/wp-starter"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
